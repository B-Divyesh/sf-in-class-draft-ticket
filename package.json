{
  "name": "in-class-draft-ticket",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "cargo run --release",
    "pretest": "cargo build && npm run test:contracts && npm run build",
    "pretest:contracts": "cargo build",
    "test": "playwright test",
    "test:contracts": "node --test contract-tests/release-contract.test.mjs",
    "test:production-topology": "node --test --test-name-pattern=@claim:production-topology contract-tests/release-contract.test.mjs"
  },
  "dependencies": {
    "svelte": "5.56.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "22.18.0",
    "playwright-core": "1.58.2",
    "typescript": "5.9.2",
    "vite": "8.2.2"
  }
}
