  "scale": {
    "minReplicas": 1,
    "maxReplicas": 1
  },
  "deploy": {
    "data_dir": "/data"
  },
  "runtime": {
    "port": 8080,
    "requiredEnvironment": [
      "PORT"
    ],
    "optionalEnvironment": [
      "DATABASE_URL"
    ]
  }
