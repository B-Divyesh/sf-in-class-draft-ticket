{
  "artifactClass": "web-with-backend",
  "containerApp": "sf-in-class-draft-ticket",
  "resourceGroup": "sociobot",
  "environment": "factory-env",
  "storage": {
    "type": "SQLite",
    "dataDirectory": "/data",
    "volumeName": "durable-data",
    "storageName": "sf-in-class-draft-ticket-data"
  },
  "scale": {
    "minReplicas": 1,
    "maxReplicas": 1
  },
  "deploy": {
    "data_dir": "/data"
  },
  "runtime": {
    "port": 8080,
    "requiredEnvironment": [
      "PORT"
    ],
    "optionalEnvironment": []
  }
}
